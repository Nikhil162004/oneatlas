# Local dev. Copy to .env.
# Neon/Railway/Render give you a pooled URL; Prisma also wants the direct one for migrate.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneatlas"
# Shared secret for POST /api/admin/ingest. Any long random string.
INGEST_TOKEN="change-me"
# Only override in tests/replay.
#OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
